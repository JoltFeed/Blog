# JoltFeed Environment Configuration
PORT=3000
PUBLIC_SITE_URL=https://joltfeed.example.com
SITE_NAME=JoltFeed

# Persistent Storage Configuration (PostgreSQL or SQLite)
DATABASE_URL=postgresql://joltfeed:changeme@localhost:5432/joltfeed
SQLITE_DATA_PATH=./data/joltfeed.sqlite
UPLOADS_DIR=./public/uploads

# Initial Administrator Bootstrap (Keep real secrets out of Git)
ADMIN_EMAIL=admin@joltfeed.com
ADMIN_PASSWORD=ChangeMeImmediately2026!
SESSION_SECRET=replace-with-64-char-random-hex-secret
